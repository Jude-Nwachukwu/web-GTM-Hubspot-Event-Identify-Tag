___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// ============================================================
// HubSpot Event & Identify Tag - GTM Custom Template Code Tab
// Dumbdata - https://dumbdata.co/
// ============================================================

const createQueue = require('createQueue');
const getUrl = require('getUrl');
const makeTableMap = require('makeTableMap');
const logToConsole = require('logToConsole');
const queryPermission = require('queryPermission');

// ─── Helpers ────────────────────────────────────────────────

var enableLogging = data.ddHubSpotEventIdentiyConsoleLog;

function log(message, value) {
  if (enableLogging) {
    if (value !== undefined) {
      logToConsole('[HubSpot Tag] ' + message, value);
    } else {
      logToConsole('[HubSpot Tag] ' + message);
    }
  }
}

// Initialise _hsq queue safely
var hsq = createQueue('_hsq');

// ─── Build HubSpot Identify payload ─────────────────────────

function buildIdentifyPayload() {
  var identifyData = {};

  // Email is always required
  identifyData.email = data.ddHubspotIDEmail;

  // Optional standard identity fields
  if (data.ddHubspotIDFirstName) {
    identifyData.firstname = data.ddHubspotIDFirstName;
  }

  if (data.ddHubspotIDLastName) {
    identifyData.lastname = data.ddHubspotIDLastName;
  }

  // Custom internal properties
  if (data.ddHubSpotCustomProperties && data.ddHubSpotCustomPropertiesTable) {
    var customProps = makeTableMap(
      data.ddHubSpotCustomPropertiesTable,
      'ddHubSpotCustomPropertiesTableCFName',
      'ddHubSpotCustomPropertiesTableValue'
    );

    if (customProps) {
      var keys = require('Object').keys(customProps);
      for (var i = 0; i < keys.length; i++) {
        identifyData[keys[i]] = customProps[keys[i]];
      }
    }
  }

  return identifyData;
}

// ─── Fire HubSpot Identify ───────────────────────────────────

function fireIdentify() {
  var identifyPayload = buildIdentifyPayload();
  log('Firing identify call with payload:', identifyPayload);
  hsq(['identify', identifyPayload]);
}

// ─── Fire HubSpot Page View ──────────────────────────────────

function firePageView() {
  var pagePathMode = data.dddHubSpotPageViewPagePath;

  if (pagePathMode === 'dddHubSpotPageViewPagePathManual') {
    // Manually supplied page path
    var manualPath = data.ddHubspotPagePathCustom;
    log('Setting manual page path:', manualPath);
    hsq(['setPath', manualPath]);
  } else {
    // Automatically resolve from current URL using GTM getUrl API
    if (queryPermission('get_url', 'path')) {
      var autoPath = getUrl('path');
      log('Setting automatic page path:', autoPath);
      hsq(['setPath', autoPath]);
    } else {
      log('get_url path permission not granted — firing trackPageView without setPath');
    }
  }

  log('Firing trackPageView');
  hsq(['trackPageView']);
}

// ─── Fire HubSpot Custom Behavioral Event ───────────────────

function fireCustomEvent() {
  var eventName = data.ddHubspotCustomEvent;
  var eventPayload = { name: eventName };

  // Include event properties if enabled
  if (data.ddHubspotCustomEventProperty && data.ddHubspotCustomEventPropertyTable) {
    var eventProps = makeTableMap(
      data.ddHubspotCustomEventPropertyTable,
      'ddHubspotCustomEventPropertyName',
      'ddHubspotCustomEventPropertyValue'
    );

    if (eventProps) {
      eventPayload.properties = eventProps;
    }
  }

  log('Firing custom behavioral event with payload:', eventPayload);
  hsq(['trackCustomBehavioralEvent', eventPayload]);
}

// ─── Fire Event Tracking (shared logic) ─────────────────────

function fireEventTracking() {
  var eventType = data.ddHubSpotEventType;

  if (eventType === 'ddHubSpotEventTypePV') {
    log('Event type: Page View');
    firePageView();
  } else if (eventType === 'ddHubSpotEventTypeCustom') {
    log('Event type: Custom Behavioral Event');
    fireCustomEvent();
  } else {
    log('Unknown event type selected — no event fired.');
  }
}

// ─── Main Execution Logic ────────────────────────────────────

var trackCallType = data.ddHubSpotCallType;
log('Track call type:', trackCallType);

if (trackCallType === 'ddHubspotTrackTypeIE') {
  // Identify + optional Event flow

  // Fire event first if the event tracking checkbox is enabled
  if (data.ddHubSpotEventTracking) {
    log('Event tracking enabled — firing event before identify');
    fireEventTracking();
  }

  // Always fire identify in this mode
  log('Firing identify call');
  fireIdentify();

} else if (trackCallType === 'ddHubspotTrackTypeEvent') {
  // Event Only flow
  log('Event Only mode — firing event tracking');
  fireEventTracking();

} else {
  log('No valid track call type selected — no calls fired.');
  data.gtmOnFailure();
  return;
}

// Signal success to GTM
log('Tag execution complete');
data.gtmOnSuccess();


